CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# OpenAI APIキー。Whisper(音声認識)とTTS(音声合成)の両方に使う。
# 同じキーでよいので両方に同じ値を入れる。 https://platform.openai.com/api-keys
WHISPER_API_KEY=
TTS_API_KEY=

# Deepseek APIキー（症状分類・翻訳）。 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Supabase（模擬病院システムのDB）。プロジェクト作成後、
# Project Settings > API（またはダッシュボード上部の「Connect」）から取得する。
# secret key を使う（publishable keyではない。旧称: service_role key / anon key）。
# backend/supabase/schema.sql を先にSQL Editorで実行しておくこと。
SUPABASE_URL=
SUPABASE_SECRET_KEY=
